# Server
SERVER_PORT=8080

# Database
FRIENDIFY_DATASOURCE_URL=jdbc:mysql://localhost:3306/friendify_monolith?createDatabaseIfNotExist=true
FRIENDIFY_DATASOURCE_USERNAME=root
FRIENDIFY_DATASOURCE_PASSWORD=
FRIENDIFY_JPA_DDL_AUTO=update
FRIENDIFY_JPA_SHOW_SQL=true

# JWT
# Use a strong random HS512 key. Keep at least 64 bytes/characters.
FRIENDIFY_JWT_SIGNER_KEY=change_me_to_a_64_character_or_longer_random_secret_key
FRIENDIFY_JWT_ISSUER=friendify.com
FRIENDIFY_JWT_VALID_DURATION=3600
FRIENDIFY_JWT_REFRESHABLE_DURATION=36000

# Brevo email
BREVO_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_NAME=Friendify
BREVO_SENDER_EMAIL=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
FRIENDIFY_OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:5173/oauth2/success
FRIENDIFY_OAUTH2_COOKIE_NAME=FRIENDIFY_ACCESS_TOKEN
# Local HTTP dev usually needs false. Use true in production HTTPS.
FRIENDIFY_OAUTH2_COOKIE_SECURE=false
FRIENDIFY_OAUTH2_COOKIE_SAME_SITE=Lax
FRIENDIFY_OAUTH2_COOKIE_PATH=/

# Initial auth data
# Keeps default USER/ADMIN roles available for registration and authorization.
FRIENDIFY_SEED_ENABLED=true
# Enable only when you intentionally want the monolith to create an initial admin user.
FRIENDIFY_SEED_ADMIN_ENABLED=false
FRIENDIFY_SEED_ADMIN_USERNAME=admin
FRIENDIFY_SEED_ADMIN_PASSWORD=
FRIENDIFY_SEED_ADMIN_EMAIL=admin@friendify.local
